# Copier ce fichier en .env puis remplir les valeurs

PORT=5000
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# Administration
ADMIN_PIN=changez-moi
# Chaîne aléatoire longue (ex : `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
ADMIN_TOKEN_SECRET=

# PostgreSQL — en ligne (Neon via Vercel) : une seule URL, prioritaire sur DB_*
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Local :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epsigate_db
DB_USER=postgres
DB_PASSWORD=postgres

# Emails (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@epsigate-photography.com
EMAIL_ADMIN=contact@epsigate-photography.com

# Vercel Blob (images) — ajouté automatiquement en liant un store Blob au projet.
# Absent : les images sont enregistrées dans ./uploads
# BLOB_READ_WRITE_TOKEN=

NODE_ENV=development
