# Copier ce fichier en .env.local puis remplir les valeurs

# Administration
ADMIN_PIN=changez-moi
# Facultatif : chaîne aléatoire longue
# (ex : `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
ADMIN_TOKEN_SECRET=

# PostgreSQL — en ligne (Neon) : une seule URL, prioritaire sur DB_*
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Local :
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epsigate_db
DB_USER=postgres
DB_PASSWORD=postgres

# Emails (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_ADMIN=

# Vercel Blob (images) — ajouté automatiquement en liant un store Blob au projet.
# Absent : les images sont enregistrées dans public/uploads
# BLOB_READ_WRITE_TOKEN=

# Facultatif : API sur un autre serveur (par défaut, celle de ce site : /api)
# NEXT_PUBLIC_API_URL=
